#!/usr/bin/env node
/**
 * openalpha CLI — read-only client for the OpenAlpha API, built for AI agents.
 *
 * Zero dependencies (Node >= 18, built-in fetch). Every command maps to a
 * GET endpoint; the API key used here is server-enforced READ-ONLY, so no
 * command in this CLI can place orders, move funds or change configuration.
 *
 * Config:
 *   OPENALPHA_API_KEY    required (create in OpenAlpha web → 设置 → 安全 → API Keys)
 *   OPENALPHA_BASE_URL   optional, default https://openalpha.top
 *
 * Exit codes: 0 ok, 1 request/usage error, 2 config error (no key, bad node).
 */
'use strict'

const DEFAULT_BASE = process.env.OPENALPHA_BASE_URL || 'https://openalpha.top'
const API_KEY = process.env.OPENALPHA_API_KEY || ''
const TIMEOUT_MS = 30000
const MAX_RETRY = 1 // network/5xx only; never retry 4xx

function die(msg, code) {
    process.stderr.write(`error: ${msg}\n`)
    process.exit(code)
}

if (!API_KEY) {
    die('OPENALPHA_API_KEY is not set. Create a key in OpenAlpha → 设置 → 安全 → API Keys, then export OPENALPHA_API_KEY=oa_...', 2)
}

// ---------- arg parsing ----------

const argv = process.argv.slice(2)
const flags = {}
const pos = []
for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--json') flags.json = true
    else if (a === '--live') flags.live = true
    else if (a === '--base-url') { i++; flags.baseUrl = argv[i] }
    else if (a.startsWith('--')) { flags[a.slice(2)] = argv[i + 1]; i++ }
    else pos.push(a)
}

const command = pos[0] || 'help'
const BASE = (flags.baseUrl || DEFAULT_BASE).replace(/\/+$/, '')

// ---------- http ----------

async function fetchOnce(path) {
    const ctrl = new AbortController()
    const timer = setTimeout(() => ctrl.abort(), TIMEOUT_MS)
    try {
        const res = await fetch(BASE + path, {
            headers: { Authorization: `Bearer ${API_KEY}` },
            signal: ctrl.signal,
        })
        const text = await res.text()
        let body = null
        try { body = text ? JSON.parse(text) : null } catch { body = null }
        return { status: res.status, body, text }
    } finally {
        clearTimeout(timer)
    }
}

function serverMessage(body, fallback) {
    if (!body) return fallback
    if (body.error && typeof body.error === 'object') return body.error.message || fallback
    if (typeof body.error === 'string') return body.error
    if (body.message) return body.message
    return fallback
}

async function api(path, what) {
    let last
    for (let attempt = 0; attempt <= MAX_RETRY; attempt++) {
        try {
            const { status, body, text } = await fetchOnce(path)
            if (status === 401) {
                die(`unauthorized (401): ${serverMessage(body, 'API key invalid or revoked')}. Create a new key in OpenAlpha → 设置 → 安全 → API Keys`, 1)
            }
            if (status === 403) {
                die(`forbidden (403): ${serverMessage(body, 'this key is read-only')}`, 1)
            }
            if (status === 451) {
                die('unavailable from your region (451): OpenAlpha blocks mainland-China IPs. Run the agent from a network that can reach openalpha.top', 1)
            }
            if (status >= 500) {
                last = `server error ${status}: ${serverMessage(body, text.slice(0, 200))}`
                if (attempt < MAX_RETRY) continue
                die(last, 1)
            }
            if (status >= 400) {
                die(`request failed (${status}): ${serverMessage(body, text.slice(0, 200))}`, 1)
            }
            if (!body || body.success === false) {
                die(`request failed: ${serverMessage(body, 'empty or malformed response')}`, 1)
            }
            return body
        } catch (e) {
            last = e.name === 'AbortError'
                ? `timeout after ${TIMEOUT_MS}ms`
                : `network error: ${e.message}`
            if (attempt < MAX_RETRY) continue
        }
    }
    die(`${what}: ${last} (base=${BASE})`, 1)
}

// ---------- output helpers ----------

const out = (s) => process.stdout.write(s + '\n')

function money(n) {
    if (typeof n !== 'number' || !Number.isFinite(n)) return '—'
    return '$' + n.toLocaleString('en-US', { maximumFractionDigits: 2 })
}

function pct(n) {
    if (typeof n !== 'number' || !Number.isFinite(n)) return '—'
    return n.toFixed(2) + '%'
}

function json(value) {
    out(JSON.stringify(value, null, 2))
}

function row(cols, widths) {
    out(cols.map((c, i) => String(c ?? '—').slice(0, widths[i]).padEnd(widths[i])).join('  '))
}

function pick(obj, keys) {
    for (const k of keys) {
        const v = obj ? obj[k] : undefined
        if (v !== undefined && v !== null && v !== '') {
            if (typeof v === 'object') {
                return v.name || v.username || v.displayName || v.label || JSON.stringify(v)
            }
            return v
        }
    }
    return null
}

// ---------- commands ----------

async function cmdWhoami() {
    const body = await api('/api/auth/me', 'whoami')
    if (flags.json) return json(body.data)
    const d = body.data || {}
    out(`user        ${d.username || d.id}`)
    if (d.displayName) out(`display     ${d.displayName}`)
    out(`role        ${d.role}`)
    out(`plan        ${d.plan}`)
    out(`auth        ${d.authMethod || 'jwt'}`)
}

/**
 * GET /api/bot/balances?exchange=X → { live: BalanceSide, demo: BalanceSide }
 * BalanceSide = { total, today_profit, profit_percent, latency, error? }.
 * An `error` side is reported AS AN ERROR — a failed query must never be
 * shown as $0 (data-honesty rule).
 */
async function cmdBalance() {
    const exchange = flags.exchange || 'okx'
    const body = await api(`/api/bot/balances?exchange=${encodeURIComponent(exchange)}`, 'balance')
    if (flags.json) return json(body.data)
    const sides = flags.live ? ['live'] : ['live', 'demo']
    for (const side of sides) {
        const s = (body.data || {})[side]
        if (!s) { out(`${side}: —`); continue }
        out(`[${side}]`)
        if (s.error) {
            out(`  error         ${s.error} (balance unknown — not a zero)`)
            continue
        }
        out(`  total         ${money(s.total)}`)
        out(`  today PnL     ${money(s.today_profit)} (${pct(s.profit_percent)})`)
    }
    out(`exchange     ${exchange}`)
}

async function cmdPositions() {
    const q = new URLSearchParams()
    q.set('exchange', flags.exchange || 'okx')
    q.set('demo', flags.live ? 'false' : 'true')
    if (flags.symbol) q.set('symbol', flags.symbol)
    const body = await api(`/api/trade/positions?${q.toString()}`, 'positions')
    if (flags.json) return json(body.data)
    const list = Array.isArray(body.data) ? body.data : []
    if (body.updatedAt) out(`snapshot at  ${body.updatedAt}${body.stale ? ' (stale)' : ''}`)
    if (list.length === 0) { out('no open positions'); return }
    row(['symbol', 'side', 'size', 'entry', 'mark', 'uPnL', 'lev'], [12, 7, 14, 12, 12, 14, 5])
    for (const p of list) {
        row([
            pick(p, ['symbol', 'instId']),
            pick(p, ['side', 'posSide']),
            pick(p, ['size', 'contracts', 'pos']),
            pick(p, ['entryPrice', 'avgPrice', 'avgPx']),
            pick(p, ['markPrice', 'lastPrice', 'last']),
            pick(p, ['unrealizedPnl', 'upl', 'pnl']),
            pick(p, ['leverage', 'lever']),
        ], [12, 7, 14, 12, 12, 14, 5])
    }
}

async function cmdDeployments() {
    const body = await api('/api/bots', 'deployments')
    if (flags.json) return json(body.data)
    const list = Array.isArray(body.data) ? body.data : []
    if (list.length === 0) { out('no deployments'); return }
    row(['id', 'name', 'status', 'exchange', 'demo', 'strategy'], [14, 22, 10, 10, 6, 26])
    for (const b of list) {
        row([
            pick(b, ['id', 'botId']),
            pick(b, ['name']),
            pick(b, ['status']),
            pick(b, ['exchange']),
            pick(b, ['demo']),
            pick(b, ['strategy', 'strategyName', 'strategyId']),
        ], [14, 22, 10, 10, 6, 26])
    }
}

async function cmdDeployment(id) {
    if (!id) die('usage: openalpha deployment <id>', 1)
    const body = await api(`/api/bots/${encodeURIComponent(id)}`, 'deployment')
    json(body.data) // detail shapes vary; agents parse JSON best
}

async function cmdStrategies() {
    const body = await api('/api/strategy-market/strategies', 'strategies')
    if (flags.json) return json(body.data)
    const raw = body.data
    const list = Array.isArray(raw) ? raw : (Array.isArray(raw?.strategies) ? raw.strategies : [])
    if (list.length === 0) { out('no strategies'); return }
    row(['id', 'name', 'creator', 'return%', 'annual%', 'sharpe', 'maxDD%'], [14, 24, 14, 10, 10, 8, 10])
    for (const s of list) {
        row([
            pick(s, ['id', 'strategyId']),
            pick(s, ['name', 'title']),
            pick(s, ['creator', 'creatorName', 'author']),
            pick(s, ['totalReturn', 'return', 'total_return']),
            pick(s, ['annualized', 'annualReturn', 'annual_return']),
            pick(s, ['sharpe', 'sharpeRatio']),
            pick(s, ['maxDrawdown', 'maxDD', 'max_drawdown']),
        ], [14, 24, 14, 10, 10, 8, 10])
    }
}

async function cmdStrategy(id) {
    if (!id) die('usage: openalpha strategy <id>', 1)
    const body = await api(`/api/strategy-market/strategies/${encodeURIComponent(id)}`, 'strategy')
    json(body.data)
}

async function cmdFactors() {
    const body = await api('/api/strategy-dev/factors', 'factors')
    if (flags.json) return json(body.data)
    const raw = body.data
    const list = Array.isArray(raw) ? raw : (Array.isArray(raw?.factors) ? raw.factors : [])
    const q = (flags.q || pos[1] || '').toLowerCase()
    const filtered = q
        ? list.filter((f) => JSON.stringify(f).toLowerCase().includes(q))
        : list
    if (filtered.length === 0) { out(`no factors${q ? ` matching "${q}"` : ''}`); return }
    row(['id', 'label', 'group', 'ready'], [22, 26, 20, 7])
    for (const f of filtered.slice(0, 100)) {
        row([
            pick(f, ['id', 'name']),
            pick(f, ['label', 'name']),
            pick(f, ['group', 'category', 'type']),
            f && f.implemented === true ? 'yes' : 'no',
        ], [22, 26, 20, 7])
    }
    if (filtered.length > 100) out(`... and ${filtered.length - 100} more (use --json)`)
}

// ---------- entry ----------

const HELP = `openalpha — read-only CLI for OpenAlpha (AI-agent friendly)

usage: openalpha <command> [args] [--json] [--live]

commands:
  whoami                     current user, plan and auth method
  balance [--exchange X]     account equity + today PnL (okx|binance, live+demo)
  positions [--exchange X]   open positions (demo by default, --live for live)
          [--live] [--symbol S]
  deployments                your strategy deployments
  deployment <id>            one deployment, full JSON
  strategies                 official strategy market
  strategy <id>              one strategy, full JSON
  factors [query]            factor library, optional substring filter
  help                       this text

flags:
  --json                     machine-readable output (full response data)
  --live                     live account instead of demo (balance/positions)
  --exchange okx|binance     exchange selector (default okx)

config:
  OPENALPHA_API_KEY          required — OpenAlpha → 设置 → 安全 → API Keys
  OPENALPHA_BASE_URL         optional, default https://openalpha.top

safety: the key is server-enforced READ-ONLY. No order, transfer, withdraw
or config change is possible through this CLI — by design, not by promise.
`

const handlers = {
    whoami: cmdWhoami,
    balance: cmdBalance,
    positions: cmdPositions,
    deployments: cmdDeployments,
    deployment: () => cmdDeployment(pos[1]),
    strategies: cmdStrategies,
    strategy: () => cmdStrategy(pos[1]),
    factors: cmdFactors,
    help: () => out(HELP),
}

if (!handlers[command]) {
    out(HELP)
    die(`unknown command: ${command}`, 1)
}
handlers[command]().catch((e) => die(e && e.message ? e.message : String(e), 1))
