#!/usr/bin/env node
/**
 * openalpha CLI — read-only client for the OpenAlpha API, built for AI agents.
 *
 * Zero dependencies (Node >= 18, built-in fetch). Every command maps to a
 * GET endpoint; the API key used here is server-enforced READ-ONLY, so no
 * command in this CLI can place orders, move funds or change configuration.
 *
 * Credential resolution (first match wins):
 *   1. OPENALPHA_API_KEY env var
 *   2. ~/.openalpha/config.json  (written by `openalpha login --key oa_...`)
 * Base URL resolution: OPENALPHA_BASE_URL env, then config file, then
 * https://openalpha.top
 *
 * Exit codes: 0 ok, 1 request/usage error, 2 config error (no key, bad node).
 */
'use strict'

const os = require('os')
const fs = require('fs')
const path = require('path')

const DEFAULT_BASE = 'https://openalpha.top'
const CONFIG_PATH = path.join(os.homedir(), '.openalpha', 'config.json')
const TIMEOUT_MS = 30000
const MAX_RETRY = 1 // network/5xx only; never retry 4xx (incl. 429)

// ---------- config file ----------

function readConfig() {
    try {
        const raw = fs.readFileSync(CONFIG_PATH, 'utf8')
        const cfg = JSON.parse(raw)
        if (cfg && typeof cfg === 'object') return cfg
    } catch { /* absent/unreadable = no config */ }
    return {}
}

function writeConfig(cfg) {
    fs.mkdirSync(path.dirname(CONFIG_PATH), { recursive: true })
    fs.writeFileSync(CONFIG_PATH, JSON.stringify(cfg, null, 2) + '\n',
        { mode: 0o600 })
}

const config = readConfig()
const API_KEY = process.env.OPENALPHA_API_KEY || config.apiKey || ''
const DEFAULT_BASE_FINAL =
    process.env.OPENALPHA_BASE_URL || config.baseUrl || DEFAULT_BASE

function die(msg, code) {
    process.stderr.write(`error: ${msg}\n`)
    process.exit(code)
}

function configHint() {
    return 'No API key configured. Either (a) run `openalpha login --key oa_...`,'
        + ' or (b) export OPENALPHA_API_KEY=oa_... . Create a key in OpenAlpha'
        + ' web → 设置 → 安全 → API Keys.'
}

// ---------- arg parsing ----------

const argv = process.argv.slice(2)
const flags = { demo: false }
const pos = []
for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a === '--json') flags.json = true
    else if (a === '--live') flags.live = true
    else if (a === '--demo') flags.demo = true
    else if (a === '--both') flags.both = true
    else if (a === '--confirm') flags.confirm = true
    else if (a === '--key') { i++; flags.key = argv[i] }
    else if (a.startsWith('--')) { flags[a.slice(2)] = argv[i + 1]; i++ }
    else pos.push(a)
}

const command = pos[0] || 'help'
const BASE = (flags.baseUrl || DEFAULT_BASE_FINAL).replace(/\/+$/, '')

// ---------- http ----------

async function fetchOnce(key, urlPath, opts) {
    const ctrl = new AbortController()
    const timer = setTimeout(() => ctrl.abort(), opts && opts.timeoutMs || TIMEOUT_MS)
    try {
        const init = { headers: {}, signal: ctrl.signal }
        if (opts && opts.method) {
            init.method = opts.method
            if (opts.body != null) {
                init.headers['Content-Type'] = 'application/json'
                init.body = JSON.stringify(opts.body)
            }
        }
        if (key) init.headers.Authorization = `Bearer ${key}`
        const res = await fetch(BASE + urlPath, init)
        const text = await res.text()
        let body = null
        try { body = text ? JSON.parse(text) : null } catch { body = null }
        return { status: res.status, body, text, headers: res.headers }
    } finally {
        clearTimeout(timer)
    }
}

function serverMessage(body, fallback) {
    if (!body) return fallback
    if (body.error && typeof body.error === 'object') {
        return body.error.message || fallback
    }
    if (typeof body.error === 'string') return body.error
    if (body.message) return body.message
    return fallback
}

const ERROR_HINTS = {
    402: ' (wallet balance too low — top up at OpenAlpha web → 钱包)',
    400: ' (if the message says 未配置 API Key: the user has not connected an'
        + ' exchange account yet — guide them to OpenAlpha web → 设置 → 交易所连接)',
    401: ' (key invalid or revoked — ask the user to create a new key:'
        + ' 设置 → 安全 → API Keys)',
    403: ' (this key is server-enforced READ-ONLY; state-changing actions must'
        + ' be done in the web UI)',
    429: ' (rate limit: 60 requests/min per key — wait and slow the polling loop)',
    451: ' (mainland-China IPs are blocked by platform policy; run from a'
        + ' network that can reach openalpha.top)',
}

async function api(urlPath, what, opts) {
    if (!API_KEY) die(configHint(), 2)
    let last
    for (let attempt = 0; attempt <= MAX_RETRY; attempt++) {
        try {
            const { status, body, text, headers } =
                await fetchOnce(API_KEY, urlPath, opts)
            if (status === 402) {
                die(`payment required (402): ${serverMessage(body, 'balance too low')}${ERROR_HINTS[402]}`, 1)
            }
            if (status === 401) {
                die(`unauthorized (401): ${serverMessage(body, 'API key invalid'
                    + ' or revoked')}${ERROR_HINTS[401]}`, 1)
            }
            if (status === 429) {
                const ra = headers.get('retry-after')
                die(`rate limited (429): retry after ${ra || 60}s${ERROR_HINTS[429]}`, 1)
            }
            if (status === 451) {
                die(`unavailable from your region (451)${ERROR_HINTS[451]}`, 1)
            }
            if (status >= 500) {
                last = `server error ${status}: ${serverMessage(body, text.slice(0, 200))}`
                if (attempt < MAX_RETRY) continue
                die(last, 1)
            }
            if (status >= 400) {
                die(`request failed (${status}): ${serverMessage(body, text.slice(0, 200))}`
                    + `${ERROR_HINTS[status] || ''}`, 1)
            }
            if (!body || body.success === false) {
                die(`request failed: ${serverMessage(body, 'empty or malformed response')}`, 1)
            }
            return body
        } catch (e) {
            last = e.name === 'AbortError'
                ? `timeout after ${TIMEOUT_MS}ms`
                : `network error: ${e.message}`
            if (attempt < MAX_RETRY) continue
        }
    }
    die(`${what}: ${last} (base=${BASE})`, 1)
}

// ---------- output helpers ----------

const out = (s = '') => process.stdout.write(s + '\n')

function money(n) {
    if (typeof n !== 'number' || !Number.isFinite(n)) return '—'
    return '$' + n.toLocaleString('en-US',
        { minimumFractionDigits: 2, maximumFractionDigits: 2 })
}

function pct(n) {
    if (typeof n !== 'number' || !Number.isFinite(n)) return '—'
    return n.toFixed(2) + '%'
}

function json(value) {
    out(JSON.stringify(value, null, 2))
}

function row(cols, widths) {
    out(cols.map((c, i) => String(c ?? '—').slice(0, widths[i]).padEnd(widths[i])).join('  '))
}

function pick(obj, keys) {
    for (const k of keys) {
        const v = obj ? obj[k] : undefined
        if (v !== undefined && v !== null && v !== '') {
            if (typeof v === 'object') {
                return v.name || v.username || v.displayName || v.label
                    || JSON.stringify(v)
            }
            return v
        }
    }
    return null
}

// ---------- auth/credential commands ----------

function cmdLogin() {
    const key = flags.key || (pos[1] && pos[1].startsWith('oa_') ? pos[1] : null)
    if (key) {
        const cfg = { ...readConfig(), apiKey: key }
        writeConfig(cfg)
        out(`key saved to ${CONFIG_PATH} (mode 600)`)
        out('note: scopes are set at key creation (web or device flow).'
            + ' verify with: openalpha whoami')
        return
    }
    loginDeviceFlow()
}

/** 设备码流: 平台签发带 scope 的 key, 浏览器一键批准, 免复制粘贴 */
async function loginDeviceFlow() {
    const clientName = flags.name || 'openalpha cli'
    const scopes = ['read']
        .concat((flags.scopes || '').split(',').map((x) => x.trim())
            .filter((x) => x === 'ask' || x === 'deploy'))
    const created = await rawJson('POST', '/api/auth/device-code', {
        clientName, scopes,
    }, 'device-code create').catch((e) => die(e.message, 1))
    const { code, verifyUrl, expiresInSec } = created.data
    out('Open the following URL in a browser, enter the code, and approve:')
    out()
    out(`  ${verifyUrl}`)
    out(`  code: ${code}   (expires in ${expiresInSec}s)`)
    out()
    out('waiting for approval', '(poll every 3s; Ctrl-C to abort)...')
    const deadline = Date.now() + (expiresInSec || 600) * 1000
    while (Date.now() < deadline) {
        await new Promise((r) => setTimeout(r, 3000))
        let poll
        try {
            poll = await rawJson('GET',
                `/api/auth/device-code/${encodeURIComponent(code)}`,
                null, 'device-code poll')
        } catch (e) {
            process.stderr.write(`  poll error: ${e.message} (retrying)\n`)
            continue
        }
        const st = poll.data && poll.data.status
        if (st === 'approved') {
            const key = poll.data.key
            if (!key) die('approved but no key returned — restart login', 1)
            writeConfig({ ...readConfig(), apiKey: key })
            out()
            out(`approved. key saved to ${CONFIG_PATH} (mode 600)`)
            out(`scopes: ${(poll.data.scopes || scopes).join(', ')}`)
            out('verify with: openalpha whoami && openalpha overview')
            return
        }
        if (st === 'denied') die('denied in browser — no key was issued', 1)
        if (st === 'expired') die('code expired — run login again', 1)
        process.stdout.write('.')
    }
    die('timed out waiting for approval — run login again', 1)
}

/** 无鉴权 JSON 请求(设备码流专用); 返回 {status,body} 形态的错误语义 */
function rawJson(method, urlPath, body, what) {
    return fetchOnce(null, urlPath, { method, body, timeoutMs: 10000 })
        .then(({ status, body: b, text }) => {
            if (status >= 400 || !b || b.success === false) {
                throw new Error(`${what} failed (${status}):`
                    + ` ${serverMessage(b, text.slice(0, 160))}`)
            }
            return b
        })
}

function cmdLogout() {
    if (!config.apiKey) { out('no saved key; nothing to do'); return }
    const cfg = { ...readConfig() }
    delete cfg.apiKey
    writeConfig(cfg)
    out(`key removed from ${CONFIG_PATH} (the key itself is still valid —`
        + ' revoke it in OpenAlpha web → 设置 → 安全 → API Keys)')
}

function cmdStatus() {
    const from = process.env.OPENALPHA_API_KEY
        ? 'env OPENALPHA_API_KEY'
        : (config.apiKey ? `config ${CONFIG_PATH}` : 'NOT CONFIGURED')
    out(`key source    ${from}`)
    if (config.apiKey || process.env.OPENALPHA_API_KEY) {
        const k = process.env.OPENALPHA_API_KEY || config.apiKey
        out(`key prefix    ${k.slice(0, 12)}…`)
    }
    out(`base url      ${BASE}`)
    out(`config file   ${fs.existsSync(CONFIG_PATH) ? CONFIG_PATH : '(absent)'}`)
    if (from === 'NOT CONFIGURED') {
        out()
        out(configHint())
        process.exitCode = 2
    }
}

// ---------- read commands ----------

async function cmdWhoami() {
    const body = await api('/api/auth/me', 'whoami')
    if (flags.json) return json(body.data)
    const d = body.data || {}
    out(`user        ${d.username || d.id}`)
    if (d.displayName) out(`display     ${d.displayName}`)
    out(`role        ${d.role}`)
    out(`plan        ${d.plan}`)
    out(`auth        ${d.authMethod || 'jwt'}`)
}

/**
 * GET /api/agent/overview — the ONE command for "how is my account doing".
 * All cross-exchange arithmetic is done SERVER-SIDE (never sum in the LLM).
 */
async function cmdOverview() {
    const body = await api('/api/agent/overview', 'overview')
    if (flags.json) return json(body.data)
    const d = body.data || {}
    const t = d.totals || {}
    out(`=== OpenAlpha overview  (${d.generatedAt || ''}) ===`)
    out()
    out('[live equity]')
    if (t.liveUsd == null && !(t.unknownSides || []).length) {
        out('  no exchange accounts connected (设置 → 交易所连接)')
    } else {
        out(`  total across exchanges   ${money(t.liveUsd)}`
            + `${t.partial ? '  (partial — see unknowns)' : ''}`)
        out(`  today PnL                ${money(t.liveTodayPnlUsd)}`)
        for (const u of t.unknownSides || []) {
            out(`  ! ${u}: query FAILED — amount unknown, NOT counted as 0`)
        }
    }
    out()
    out('[strategy deployments]')
    const deps = d.strategyDeployments || []
    if (deps.length === 0) {
        out('  none')
    } else {
        row(['name', 'status', 'equity', 'return', 'annual', 'maxDD', 'days'],
            [20, 10, 12, 9, 9, 8, 6])
        for (const dep of deps) {
            const m = dep.metrics || {}
            row([
                dep.name,
                dep.status + (dep.processAlive === false
                    && dep.status === 'running' ? '!' : ''),
                money(m.latestEquityUsd),
                pct(m.totalReturnPct),
                pct(m.annualizedPct),
                pct(m.maxDrawdownPct),
                m.days ?? '—',
            ], [20, 10, 12, 9, 9, 8, 6])
        }
        out('  (! = marked running but executor process is not alive)')
    }
    const bots = d.bots || { total: 0, running: 0 }
    out()
    out(`[orderflow bots]  ${bots.running}/${bots.total} running`)
    const anomalies = d.anomalies || []
    out()
    if (anomalies.length > 0) {
        out('[anomalies]')
        for (const a of anomalies) out(`  ! ${a}`)
    } else {
        out('[anomalies]  none')
    }
}

/**
 * GET /api/bot/balances?exchange=X → { live: Side, demo: Side }.
 * DEFAULTS TO LIVE. --demo switches the side; --both prints both.
 * A side with `error` is UNKNOWN — never presented as $0.
 */
async function cmdBalance() {
    const exchange = flags.exchange || 'okx'
    const body = await api(
        `/api/bot/balances?exchange=${encodeURIComponent(exchange)}`, 'balance')
    if (flags.json) return json(body.data)
    const sides = flags.both ? ['live', 'demo']
        : (flags.demo ? ['demo'] : ['live'])
    for (const side of sides) {
        const s = (body.data || {})[side]
        if (!s) { out(`[${side}] —`); continue }
        out(`[${side}]`)
        if (s.needsConfig) {
            out('  not configured (connect the exchange in OpenAlpha web)')
            continue
        }
        if (s.error) {
            out(`  error         ${s.error} (balance unknown — NOT zero)`)
            continue
        }
        out(`  total         ${money(s.total)}`)
        out(`  today PnL     ${money(s.today_profit)} (${pct(s.profit_percent)})`)
    }
    out(`exchange     ${exchange}`
        + `${flags.demo || flags.both ? '' : '  (live side shown; --demo / --both)'}`)
}

/** DEFAULTS TO LIVE; --demo for the demo account. */
async function cmdPositions() {
    const q = new URLSearchParams()
    q.set('exchange', flags.exchange || 'okx')
    q.set('demo', flags.demo ? 'true' : 'false')
    if (flags.symbol) q.set('symbol', flags.symbol)
    const body = await api(`/api/trade/positions?${q.toString()}`, 'positions')
    if (flags.json) return json(body.data)
    const list = Array.isArray(body.data) ? body.data : []
    out(`account      ${flags.demo ? 'DEMO' : 'LIVE'} (${flags.exchange || 'okx'})`)
    if (body.updatedAt) {
        out(`snapshot at  ${body.updatedAt}${body.stale ? ' (stale)' : ''}`)
    }
    if (list.length === 0) { out('no open positions'); return }
    row(['symbol', 'side', 'size', 'entry', 'mark', 'uPnL', 'lev'],
        [14, 7, 14, 12, 12, 14, 5])
    for (const p of list) {
        row([
            pick(p, ['symbol', 'instId']),
            pick(p, ['side', 'posSide']),
            pick(p, ['size', 'contracts', 'pos']),
            pick(p, ['entryPrice', 'avgPrice', 'avgPx']),
            pick(p, ['markPrice', 'lastPrice', 'last']),
            pick(p, ['unrealizedPnl', 'upl', 'pnl']),
            pick(p, ['leverage', 'lever']),
        ], [14, 7, 14, 12, 12, 14, 5])
    }
}

/** 策略部署(strategy_deployments, 执行器真实曲线) */
async function cmdDeployments() {
    const body = await api('/api/strategy-dev/deployments', 'deployments')
    if (flags.json) return json(body.data)
    const list = Array.isArray(body.data) ? body.data : []
    if (list.length === 0) { out('no strategy deployments'); return }
    row(['id', 'name', 'status', 'exch', 'mode', 'equity', 'return'],
        [16, 20, 10, 6, 6, 12, 9])
    for (const dep of list) {
        const curve = Array.isArray(dep.live && dep.live.equityCurve)
            ? dep.live.equityCurve : []
        let eq = null
        let ret = null
        if (curve.length >= 2) {
            eq = curve[curve.length - 1].eq
            ret = curve[0].eq ? (eq / curve[0].eq - 1) * 100 : null
        }
        const r = ret != null ? Math.round(ret * 100) / 100 : null
        row([
            dep.id,
            dep.name,
            dep.status + (dep.processAlive === false ? '!' : ''),
            dep.exchange,
            dep.demo ? 'demo' : 'live',
            money(eq),
            pct(r),
        ], [16, 20, 10, 6, 6, 12, 9])
    }
    out('(! = process not alive; full metrics per deployment: openalpha overview)')
}

/** 单个策略部署详情(列表 JSON 按 id 过滤, 含执行器状态/日志尾) */
async function cmdDeployment(id) {
    if (!id) die('usage: openalpha deployment <id>', 1)
    const body = await api('/api/strategy-dev/deployments', 'deployment')
    const list = Array.isArray(body.data) ? body.data : []
    const dep = list.find((x) => x && x.id === id)
    if (!dep) die(`deployment ${id} not found (check openalpha deployments)`, 1)
    json(dep)
}

/** V40 订单流机器人(与策略部署是两条产品线) */
async function cmdBots() {
    const body = await api('/api/bots', 'bots')
    if (flags.json) return json(body.data)
    const list = Array.isArray(body.data) ? body.data : []
    if (list.length === 0) { out('no bots'); return }
    row(['id', 'name', 'status', 'exchange', 'mode'], [16, 22, 10, 10, 6])
    for (const b of list) {
        const demo = pick(b, ['demo'])
        row([
            pick(b, ['id', 'botId']),
            pick(b, ['name']),
            pick(b, ['status']),
            pick(b, ['exchange']),
            demo === true || demo === 'true' ? 'demo' : 'live',
        ], [16, 22, 10, 10, 6])
    }
}

async function cmdStrategies() {
    const body = await api('/api/strategy-market/strategies', 'strategies')
    if (flags.json) return json(body.data)
    const raw = body.data
    const list = Array.isArray(raw) ? raw
        : (Array.isArray(raw?.strategies) ? raw.strategies : [])
    if (list.length === 0) { out('no strategies'); return }
    row(['id', 'name', 'creator', 'return%', 'annual%', 'sharpe', 'maxDD%'],
        [14, 24, 14, 10, 10, 8, 10])
    for (const s of list) {
        row([
            pick(s, ['id', 'strategyId']),
            pick(s, ['name', 'title']),
            pick(s, ['creator', 'creatorName', 'author']),
            pick(s, ['totalReturn', 'return', 'total_return']),
            pick(s, ['annualized', 'annualReturn', 'annual_return']),
            pick(s, ['sharpe', 'sharpeRatio']),
            pick(s, ['maxDrawdown', 'maxDD', 'max_drawdown']),
        ], [14, 24, 14, 10, 10, 8, 10])
    }
}

async function cmdStrategy(id) {
    if (!id) die('usage: openalpha strategy <id>', 1)
    const body = await api(
        `/api/strategy-market/strategies/${encodeURIComponent(id)}`, 'strategy')
    json(body.data)
}

async function cmdFactors() {
    const body = await api('/api/strategy-dev/factors', 'factors')
    if (flags.json) return json(body.data)
    const raw = body.data
    const list = Array.isArray(raw) ? raw
        : (Array.isArray(raw?.factors) ? raw.factors : [])
    const q = (flags.q || pos[1] || '').toLowerCase()
    const filtered = q
        ? list.filter((f) => JSON.stringify(f).toLowerCase().includes(q))
        : list
    if (filtered.length === 0) {
        out(`no factors${q ? ` matching "${q}"` : ''}`)
        return
    }
    row(['id', 'label', 'group', 'ready'], [22, 26, 20, 7])
    for (const f of filtered.slice(0, 100)) {
        row([
            pick(f, ['id', 'name']),
            pick(f, ['label', 'name']),
            pick(f, ['group', 'category', 'type']),
            f && f.implemented === true ? 'yes' : 'no',
        ], [22, 26, 20, 7])
    }
    if (filtered.length > 100) out(`... and ${filtered.length - 100} more (use --json)`)
}

/** AI 问答(需 key 带 ask scope; 按 token 计费, requestId 幂等防重扣) */
async function cmdAsk() {
    const question = pos.slice(1).join(' ').trim()
    if (!question) die('usage: openalpha ask "your question"', 1)
    // 服务端幂等: 同 requestId 同问题重试复用结果(网络重试不重复扣费)
    const requestId = 'cli-' + Date.now().toString(36) + '-'
        + Math.random().toString(36).slice(2, 8)
    const body = await api('/api/agent/ask', 'ask',
        { method: 'POST', body: { question, requestId } })
    if (flags.json) return json(body.data)
    const d = body.data || {}
    out(String(d.answer || ''))
    out()
    out(`--- tokens ${d.tokens} · charged $${Number(d.chargedUsd || 0).toFixed(4)}`
        + ` · balance $${Number(d.balance || 0).toFixed(4)}`)
}

/**
 * 部署启停(需 key 带 deploy scope)。
 * --confirm 是硬闸: agent 协议要求先向用户复述摘要、得到明确同意后才执行
 * (见 SKILL.md); CLI 再拦一道, 双保险。
 */
async function cmdDeploy() {
    const action = pos[1]
    const id = pos[2]
    const allowed = ['stop', 'start', 'restart']
    if (!allowed.includes(action) || !id) {
        die('usage: openalpha deploy stop|start <deployment-id> --confirm', 1)
    }
    if (!flags.confirm) {
        die(`refusing to ${action} deployment ${id} without --confirm.`
            + ' Show the user a summary first; run again with --confirm'
            + ' only after they explicitly agree.', 1)
    }
    const endpoint = action === 'start' ? 'restart' : action
    const body = await api(
        `/api/strategy-dev/deployments/${encodeURIComponent(id)}/${endpoint}`,
        `deploy ${action}`, { method: 'POST', body: {} })
    if (flags.json) return json(body.data)
    const d = body.data != null && typeof body.data === 'object' ? body.data : {}
    out(`action       ${action} ${id}`)
    const status = d.status || (d.deployment && d.deployment.status) || 'ok'
    out(`status       ${status}`)
    if (d.message) out(`message      ${d.message}`)
}

/** 双所新上市 USDT 永续雷达(池准入信号) */
async function cmdMarket() {
    const sub = pos[1] || 'listings'
    if (sub !== 'listings') die('usage: openalpha market listings [--days N]', 1)
    const days = Number(flags.days) || 14
    const body = await api(
        `/api/agent/market/listings?days=${encodeURIComponent(days)}`,
        'market listings')
    if (flags.json) return json(body.data)
    const d = body.data || {}
    const list = d.listings || []
    out(`近 ${d.windowDays || days} 天新上市 USDT 永续(双所合计 ${list.length} 个)`)
    for (const e of d.errors || []) out(`! 数据降级: ${e}`)
    if (list.length === 0) { out('  无'); return }
    row(['exchange', 'symbol', 'days'], [9, 24, 6])
    for (const r of list) row([r.exchange, r.symbol, r.daysListed], [9, 24, 6])
    out('(新币波动/流动性结构特殊 —— 进池前先观察, 上市效应是真实信号也是真实风险)')
}

// ---------- entry ----------

const HELP = `openalpha — read-only CLI for OpenAlpha (AI-agent friendly)

usage: openalpha <command> [args] [--json]

account & setup:
  login                      device-code flow: browser approval, zero copy-paste
         [--name N] [--scopes ask,deploy]
  login --key oa_...         save an existing key to config (mode 600)
  logout                     remove saved key (revoke it in the web too)
  status                     where is the key coming from / base url
  whoami                     current user, plan and auth method

monitoring:
  overview                   ONE-SHOT: cross-exchange equity, today PnL,
                             deployment metrics, anomalies (server-side math)
  balance [--exchange X]     equity + today PnL (DEFAULT LIVE; --demo / --both)
  positions [--exchange X]   open positions (DEFAULT LIVE; --demo to switch)
           [--demo] [--symbol S]

market radar:
  market listings [--days N]  newly listed USDT perps on OKX/Binance
                             (pool-admission signal; default 14d)

actions & ai (need matching key scope):
  ask "question"             platform AI Q&A with live account context
                             (billed per token; scope: ask)
  deploy stop|start <id>     stop / restart a strategy deployment
         --confirm           (scope: deploy; --confirm required)

deployments & research:
  deployments                strategy deployments (executor curve metrics)
  deployment <id>            one deployment, full JSON
  bots                       V40 orderflow bots (separate product line)
  strategies                 official strategy market
  strategy <id>              one strategy, full JSON
  factors [query]            factor library, optional substring filter
  help                       this text

flags:
  --json                     machine-readable output (full response data)
  --demo / --both            account side selectors (default: live)
  --exchange okx|binance     exchange selector (default okx)

config (first match wins):
  OPENALPHA_API_KEY env  →  ~/.openalpha/config.json  (via login --key)
  OPENALPHA_BASE_URL env →  config file → https://openalpha.top

safety: the key is server-enforced READ-ONLY — no orders, transfers,
withdrawals or config changes are possible through this CLI. Rate limit:
60 requests/minute per key (429 + Retry-After when exceeded).
`

const handlers = {
    login: cmdLogin,
    ask: cmdAsk,
    deploy: cmdDeploy,
    market: cmdMarket,
    logout: cmdLogout,
    status: cmdStatus,
    whoami: cmdWhoami,
    overview: cmdOverview,
    balance: cmdBalance,
    positions: cmdPositions,
    deployments: cmdDeployments,
    deployment: () => cmdDeployment(pos[1]),
    bots: cmdBots,
    strategies: cmdStrategies,
    strategy: () => cmdStrategy(pos[1]),
    factors: cmdFactors,
    help: () => out(HELP),
}

if (!handlers[command]) {
    out(HELP)
    die(`unknown command: ${command}`, 1)
}

Promise.resolve(handlers[command]())
    .catch((e) => die(e && e.message ? e.message : String(e), 1))
